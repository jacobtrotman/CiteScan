# URL of the CiteScan server (see ../server). On a physical phone use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Must match APP_TOKEN on the server
EXPO_PUBLIC_APP_TOKEN=
# RevenueCat public SDK key. Use the Test Store key (starts with test_) for Expo Go.
EXPO_PUBLIC_REVENUECAT_API_KEY=
