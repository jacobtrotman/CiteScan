# Required: your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=
# Shared secret the mobile app sends as "Authorization: Bearer <token>". Set this in production.
APP_TOKEN=
# Optional: contact email for the OpenAlex/Crossref "polite pool" (faster, more reliable)
CONTACT_EMAIL=
# Optional: OpenAlex API key for higher search limits
OPENALEX_API_KEY=
PORT=3000
